struct Message {
    body: string
    seq: u64
}

error Rejected {
    message = f"rejected: {self.reason}"
    reason: string
}

error TooLong {
    message = f"too long: {self.limit} max"
    limit: u32
}

protocol Chat {
    /// Request/response with a struct return, raising either of two errors.
    function send(text: string) -> Message ! Rejected, TooLong;
    /// Fire-and-forget.
    function note(text: string);
}
