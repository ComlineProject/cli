congregation acme_lines
specification_version = 1

encodings = {
    "com.acme.lines@1" = {
        kind = "framing"
        profile = "profiles/lines.json"
    }
}

// Every string and list has a maximum (bounds on types); these are the
// defaults where a type writes none.
settings = {
    bounds = {
        string = {
            max = 256
        }
        array = {
            max = 1024
        }
    }
}
